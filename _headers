# Response headers for all paths (Cloudflare Pages).
# Browsers check before reusing any file, so a release never mixes new pages with old scripts.
/*
  Cache-Control: public, no-transform, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

# The check page engine: compressed, and kept by browsers (the folder name changes with each engine version).
/geodequill/check/pyodide-314.0.7/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
